// YoutubeBot Manager window: sidebar navigation, header with breadcrumb and search, the
// active page and a status footer. Keyboard: Ctrl+R refresh, Ctrl+K search, Ctrl+1…8
// sections, arrows/Home/End move in the page list, Enter opens, Esc clears.

import { LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Store, Bridge } from "store.slint";
import { Btn, NavItem, Caption, Badge, Body, NoticeView } from "controls.slint";
import {
    CentralPage, OverviewPage, ChannelsPage, ShortsPage, SocialPage, CommercialPage, SessionsPage,
    SettingsPage,
} from "pages.slint";

export { Theme } from "theme.slint";
export {
    Store, Bridge, Notice, Fact, Kpi, UpcomingRow, ChannelCard, VideoRow, ShortRow, XPostRow,
    ContactRow, ProductRow, SourceRow, SessionRow,
} from "store.slint";

export component AppWindow inherits Window {
    title: "YoutubeBot Manager";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 720px;
    // Explicit, so a fixed-size child never caps how far the owner can enlarge the window.
    max-width: 100000px;
    max-height: 100000px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.text-sm;
    forward-focus: keys;

    in-out property <bool> dark <=> Theme.dark;
    property <[string]> titles: [
        "Central", "Visão geral", "Canais", "Shorts", "Social (X)", "Comercial", "Sessões",
        "Configurações",
    ];

    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }

    function go(page: int) {
        Bridge.navigate(page);
    }

    function list-length() -> int {
        if (Store.page == 0) {
            return Store.interventions.length;
        }
        if (Store.page == 1) {
            return Store.upcoming.length;
        }
        if (Store.page == 2) {
            return Store.channel-open ? Store.videos.length : Store.channels.length;
        }
        if (Store.page == 3) {
            return Store.shorts.length;
        }
        if (Store.page == 4) {
            return Store.x-posts.length;
        }
        if (Store.page == 5) {
            return Store.wa-contacts.length;
        }
        if (Store.page == 6) {
            return Store.sessions.length;
        }
        return Store.sources.length;
    }

    function list-current() -> int {
        if (Store.page == 0) {
            return Store.intervention-current;
        }
        if (Store.page == 1) {
            return Store.upcoming-current;
        }
        if (Store.page == 2) {
            return Store.channel-open ? Store.video-current : Store.channel-current;
        }
        if (Store.page == 3) {
            return Store.short-current;
        }
        if (Store.page == 4) {
            return Store.x-current;
        }
        if (Store.page == 5) {
            return Store.contact-current;
        }
        if (Store.page == 6) {
            return Store.session-current;
        }
        return Store.source-current;
    }

    function set-current(value: int) {
        if (Store.page == 0) {
            Store.intervention-current = value;
        } else if (Store.page == 1) {
            Store.upcoming-current = value;
        } else if (Store.page == 2 && Store.channel-open) {
            Store.video-current = value;
        } else if (Store.page == 2) {
            Store.channel-current = value;
        } else if (Store.page == 3) {
            Store.short-current = value;
        } else if (Store.page == 4) {
            Store.x-current = value;
        } else if (Store.page == 5) {
            Store.contact-current = value;
        } else if (Store.page == 6) {
            Store.session-current = value;
        } else {
            Store.source-current = value;
        }
    }

    function move-to(target: int) {
        let count = root.list-length();
        if (count == 0) {
            return;
        }
        root.set-current(Math.max(0, Math.min(count - 1, target)));
    }

    function move(delta: int) {
        let current = root.list-current();
        if (current < 0) {
            root.move-to(delta > 0 ? 0 : root.list-length() - 1);
        } else {
            root.move-to(current + delta);
        }
    }

    function activate() {
        if (Store.page == 0 && Store.intervention-current >= 0) {
            Bridge.open-conversation(Store.intervention-current);
        }
        if (Store.page == 2 && !Store.channel-open && Store.channel-current >= 0) {
            Bridge.open-channel(Store.channel-current);
        }
    }

    function clear-selection() {
        if (Store.page == 2 && Store.channel-open) {
            Store.channel-open = false;
            Store.video-current = -1;
        } else {
            Store.intervention-current = -1;
            Store.upcoming-current = -1;
            Store.channel-current = -1;
            Store.short-current = -1;
            Store.x-current = -1;
            Store.contact-current = -1;
            Store.session-current = -1;
            Store.source-current = -1;
        }
        if (Store.search-text != "") {
            Store.search-text = "";
            Bridge.search-changed("");
        }
        keys.focus();
    }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;

        KeyBinding {
            keys: @keys(Control + "r");
            activated => {
                Bridge.refresh();
            }
        }
        KeyBinding {
            keys: @keys(Control + "k");
            activated => {
                search.focus();
                search.select-all();
            }
        }
        KeyBinding {
            keys: @keys(Control + "1");
            activated => {
                root.go(0);
            }
        }
        KeyBinding {
            keys: @keys(Control + "2");
            activated => {
                root.go(1);
            }
        }
        KeyBinding {
            keys: @keys(Control + "3");
            activated => {
                root.go(2);
            }
        }
        KeyBinding {
            keys: @keys(Control + "4");
            activated => {
                root.go(3);
            }
        }
        KeyBinding {
            keys: @keys(Control + "5");
            activated => {
                root.go(4);
            }
        }
        KeyBinding {
            keys: @keys(Control + "6");
            activated => {
                root.go(5);
            }
        }
        KeyBinding {
            keys: @keys(Control + "7");
            activated => {
                root.go(6);
            }
        }
        KeyBinding {
            keys: @keys(Control + "8");
            activated => {
                root.go(7);
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.clear-selection();
            }
        }
        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                root.move(1);
            }
        }
        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                root.move(-1);
            }
        }
        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.move(1);
            }
        }
        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.move(-1);
            }
        }
        KeyBinding {
            keys: @keys(PageDown);
            activated => {
                root.move(10);
            }
        }
        KeyBinding {
            keys: @keys(PageUp);
            activated => {
                root.move(-10);
            }
        }
        KeyBinding {
            keys: @keys(Home);
            activated => {
                root.move-to(0);
            }
        }
        KeyBinding {
            keys: @keys(End);
            activated => {
                root.move-to(root.list-length() - 1);
            }
        }
        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.activate();
            }
        }

        HorizontalLayout {
            spacing: 0;

            // Sidebar
            Rectangle {
                width: 232px;
                background: Theme.sidebar;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding: Theme.space-4;
                    spacing: Theme.space-1;

                    VerticalLayout {
                        padding-left: Theme.space-3;
                        padding-bottom: Theme.space-4;
                        Text {
                            text: "YoutubeBot";
                            font-family: Theme.font;
                            font-size: Theme.text-lg;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Caption {
                            text: "Manager · somente leitura";
                        }
                    }

                    for title[index] in root.titles: NavItem {
                        text: title;
                        shortcut: "Ctrl+" + (index + 1);
                        active: Store.page == index;
                        clicked => {
                            root.go(index);
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Btn {
                        text: Theme.dark ? "Usar tema claro" : "Usar tema escuro";
                        kind: "ghost";
                        clicked => {
                            Bridge.theme-picked(!Theme.dark);
                        }
                    }
                }
            }

            // Main column
            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 76px;

                    HorizontalLayout {
                        padding-left: Theme.space-8;
                        padding-right: Theme.space-8;
                        spacing: Theme.space-4;

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-1;
                            Caption {
                                text: "YoutubeBot  /  " + root.titles[Store.page] + (Store.page == 2 && Store.channel-open ? "  /  " + Store.channel-detail.name : "");
                                accessible-label: "Caminho: " + self.text;
                            }
                            Text {
                                text: Store.page == 2 && Store.channel-open ? Store.channel-detail.name : root.titles[Store.page];
                                font-family: Theme.font;
                                font-size: Theme.text-xl;
                                font-weight: 700;
                                color: Theme.text;
                                accessible-role: AccessibleRole.text;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        VerticalLayout {
                            alignment: center;
                            search := LineEdit {
                                width: 300px;
                                placeholder-text: "Buscar nesta página (Ctrl+K)";
                                text <=> Store.search-text;
                                accessible-label: "Buscar nesta página";
                                edited(text) => {
                                    Bridge.search-changed(text);
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Btn {
                                text: Store.loading ? "Atualizando…" : "Atualizar";
                                description: "Ctrl+R";
                                enabled: !Store.loading;
                                clicked => {
                                    Bridge.refresh();
                                }
                            }
                        }
                    }
                }

                if Store.login-banner != "": Rectangle {
                    height: 44px;
                    background: Theme.surface;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-8;
                        padding-right: Theme.space-8;
                        spacing: Theme.space-3;
                        Badge {
                            text: "Login necessário";
                            tone: 2;
                        }
                        Body {
                            text: Store.login-banner;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-left: Theme.space-8;
                        padding-right: Theme.space-8;
                        padding-top: Theme.space-2;
                        padding-bottom: Theme.space-6;

                        if Store.root-notice.kind != 0 && Store.page != 7: NoticeView {
                            notice: Store.root-notice;
                            action-text: "Abrir configurações";
                            action => {
                                root.go(7);
                            }
                        }

                        if Store.root-notice.kind == 0 && Store.page == 0: CentralPage { }
                        if Store.root-notice.kind == 0 && Store.page == 1: OverviewPage { }
                        if Store.root-notice.kind == 0 && Store.page == 2: ChannelsPage { }
                        if Store.root-notice.kind == 0 && Store.page == 3: ShortsPage { }
                        if Store.root-notice.kind == 0 && Store.page == 4: SocialPage { }
                        if Store.root-notice.kind == 0 && Store.page == 5: CommercialPage { }
                        if Store.root-notice.kind == 0 && Store.page == 6: SessionsPage { }
                        if Store.page == 7: SettingsPage { }
                    }
                }

                Rectangle {
                    height: 32px;
                    background: Theme.sidebar;

                    Rectangle {
                        height: 1px;
                        y: 0;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-8;
                        padding-right: Theme.space-8;
                        spacing: Theme.space-4;
                        Caption {
                            text: Store.status-text;
                            color: Theme.text-muted;
                            overflow: elide;
                            accessible-label: "Status: " + self.text;
                        }
                        Caption {
                            horizontal-stretch: 0;
                            text: Store.loading ? "Atualizando…" : Store.updated-text;
                        }
                    }
                }
            }
        }
    }
}
